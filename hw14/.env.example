# =====================================================
#  Plantilla de variables de entorno - Fábula Dental
#  Copia este archivo como ".env" y llena los valores.
#  Este archivo SÍ se sube a GitHub (no tiene valores reales).
# =====================================================

# Google OAuth 2.0
# Obtenlos en: https://console.cloud.google.com/ → APIs y servicios → Credenciales
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# URL de redirección OAuth (debe coincidir exactamente con Google Cloud Console)
# Local:      http://localhost/hw14/Fabula-Dental-Managment/auth/callback.php
# Producción: https://fabula-dental-hw14.onrender.com/auth/callback.php
GOOGLE_REDIRECT_URI=http://localhost/hw14/Fabula-Dental-Managment/auth/callback.php
